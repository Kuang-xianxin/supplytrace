# Local-only defaults; no paid credentials required for rules mode.
# Project .env takes precedence. Inherited process credentials are ignored unless
# SUPPLYTRACE_USE_PROCESS_ENV=true is explicitly set in the launch environment.
DATA_BACKEND=synthetic
OPENAI_BASE_URL=http://127.0.0.1:11435/v1
OPENAI_MODEL=
OPENAI_API_KEY=local-placeholder
MODEL_TIMEOUT_SECONDS=40
DAILY_RUN_LIMIT=100
METERLESS_ENABLED=true
# Use Zetaris only after provisioning the four read-only views described in docs/INTEGRATIONS.md.
ZETARIS_BASE_URL=https://api.saas.enterprise.zetaris.com
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_CATALOG=supplytrace
ZETARIS_API_PREFIX=/api/v1.0
# For the official local Docker UI: base=http://localhost:3000 and prefix=/api/proxy.
# Leave API key empty to use a private local username/password; never commit them.
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
DATASET_KIND=original_synthetic_demo
DATASET_AS_OF=2026-10-22
# Optional NVIDIA NIM uses the same OpenAI-compatible planner. Do not mark verified until tested.
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_MODEL=<deployed-nim-model>
